[Unit]
Description=UndoOS privileged system service
Requires=lifeline-system.socket
After=lifeline-system.socket

[Service]
Type=simple
ExecStart=/usr/local/libexec/lifeline-systemd
User=root
Group=root
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# Allow writes only to the recovery store and the single approved hostname file.
ReadWritePaths=/var/lib/lifeline/system /etc/hostname
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Polkit binds authorization to SO_PEERCRED using /proc/<pid>/stat.
ProtectProc=default
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
