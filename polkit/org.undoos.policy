<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>UndoOS</vendor>
  <vendor_url>https://github.com/voidsgnl/undoos</vendor_url>

  <action id="org.undoos.system.recover-file">
    <description>Restore a protected system file</description>
    <message>Authentication is required to restore a protected system file.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.undoos.system.capture-file">
    <description>Capture an approved system file for UndoOS recovery</description>
    <message>Authentication is required to capture an approved system file.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
